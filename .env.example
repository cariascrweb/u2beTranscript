# Copy to .env and fill in (from Cloudflare dashboard -> Turnstile)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Daily caps on transcripts (0 = no limit). Reset at local midnight or on restart.
DAILY_LIMIT=50
PER_IP_DAILY_LIMIT=10
# Hours from UTC for the midnight reset (Costa Rica = -6)
UTC_OFFSET_HOURS=-6
